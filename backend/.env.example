# Neon Postgres 연결 문자열 (Neon 대시보드에서 복사)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT 서명 키 (openssl rand -base64 32 등으로 생성)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="365d"

# 프론트엔드 배포 도메인 (CORS 허용용, 콤마로 여러 개 구분 가능)
FRONTEND_ORIGIN="http://localhost:5173"

# 카카오/구글 OAuth
# redirect_uri는 프론트에서 인가 코드를 받아온 콜백 주소와 정확히 일치해야 함 (카카오/구글 콘솔에 등록한 값과 동일하게)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:5173/auth/kakao/callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"

# Cloudinary (이미지 업로드 서명용, 클라이언트 unsigned upload면 preset만 있어도 됨)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# Ravelry API
RAVELRY_API_KEY=""
RAVELRY_API_SECRET=""
